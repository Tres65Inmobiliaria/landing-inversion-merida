rules_version = '2';

// Reglas del proyecto Firebase EXCLUSIVO de la landing "Diversifica tu patrimonio en Mérida".
// No se comparten con el CRM/portal de TRES65.
//
// - Público: SOLO puede crear su propio cuestionario (validado campo por campo).
//   No puede leer, listar, editar ni borrar prospectos.
// - Admin: usuario autenticado cuyo UID existe en /admins/{uid}. Ese documento
//   solo se crea desde la consola de Firebase (nadie puede escribirlo desde la web).
//   Puede leer prospectos y cambiar únicamente estado / notas internas.
// - Nadie puede borrar prospectos desde la web (solo desde la consola).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function strList(v, min, max) {
      return v is list && v.size() >= min && v.size() <= max;
    }

    function prospectKeys() {
      return [
        'id', 'schemaVersion', 'createdAt', 'updatedAt',
        'fullName', 'email', 'phone',
        'diversificationInterest', 'previousRealEstateInvestment',
        'previousInvestmentTypes', 'previousInvestmentTypeOther', 'previousInvestmentLocation',
        'investmentBudget', 'purchaseMethod', 'financingInterest',
        'investmentTimeline', 'decisionMakers', 'decisionMakersOther',
        'investmentPurposes', 'investmentPurposeOther', 'personalUse',
        'meridaExperience', 'meridaMarketKnowledge', 'preferredArea', 'openToRecommendations',
        'eventInterest',
        'privacyConsent', 'privacyConsentAt',
        'source', 'campaign', 'assignedAgent', 'status',
        'utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term',
        'referrer', 'landingUrl'
      ];
    }

    function validNewProspect(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(prospectKeys())
        && d.keys().hasAll(prospectKeys())
        && d.id == id
        && d.schemaVersion == 1
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && d.privacyConsentAt == request.time
        // Contacto
        && str(d.fullName, 3, 120)
        && str(d.email, 5, 254)
        && d.email.matches('^[^\\s@]+@[^\\s@]+\\.[A-Za-z]{2,}$')
        && str(d.phone, 8, 20)
        && d.phone.matches('^\\+[0-9]{10,15}$')
        // Respuestas (códigos cortos; la lista de opciones vive en src/config)
        && str(d.diversificationInterest, 1, 40)
        && d.previousRealEstateInvestment in ['si', 'no']
        && strList(d.previousInvestmentTypes, 0, 10)
        && str(d.previousInvestmentTypeOther, 0, 160)
        && str(d.previousInvestmentLocation, 0, 160)
        && str(d.investmentBudget, 1, 40)
        && str(d.purchaseMethod, 1, 40)
        && str(d.financingInterest, 1, 40)
        && str(d.investmentTimeline, 1, 40)
        && strList(d.decisionMakers, 1, 10)
        && str(d.decisionMakersOther, 0, 160)
        && strList(d.investmentPurposes, 1, 10)
        && str(d.investmentPurposeOther, 0, 160)
        && str(d.personalUse, 1, 40)
        && str(d.meridaExperience, 1, 40)
        && str(d.meridaMarketKnowledge, 1, 40)
        && str(d.preferredArea, 0, 160)
        && d.openToRecommendations is bool
        && str(d.eventInterest, 1, 40)
        // Consentimiento obligatorio
        && d.privacyConsent == true
        // Valores fijos de la campaña: el público no puede auto-asignarse otro estado
        && d.source == 'landing'
        && str(d.campaign, 1, 60)
        && str(d.assignedAgent, 1, 80)
        && d.status == 'nuevo'
        // Atribución
        && str(d.utm_source, 0, 200)
        && str(d.utm_medium, 0, 200)
        && str(d.utm_campaign, 0, 200)
        && str(d.utm_content, 0, 200)
        && str(d.utm_term, 0, 200)
        && str(d.referrer, 0, 500)
        && str(d.landingUrl, 0, 500);
    }

    function validAdminUpdate() {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return changed.hasOnly(['status', 'statusUpdatedAt', 'statusUpdatedBy', 'internalNotes', 'updatedAt'])
        && d.updatedAt == request.time
        && d.status in ['nuevo', 'contactado', 'seguimiento', 'cita_agendada',
                        'interesado', 'no_interesado', 'cerrado']
        && (!('internalNotes' in d) || strList(d.internalNotes, 0, 500))
        && (!('statusUpdatedBy' in d) || str(d.statusUpdatedBy, 0, 254));
    }

    match /prospects/{prospectId} {
      allow create: if validNewProspect(prospectId);
      allow get, list: if isAdmin();
      allow update: if isAdmin() && validAdminUpdate();
      allow delete: if false;
    }

    // Lista de administradores. Solo lectura del propio registro (para que el
    // panel sepa si mostrar el dashboard). Se administra desde la consola.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
