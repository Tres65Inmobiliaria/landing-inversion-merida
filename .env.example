# Copia este archivo a .env.local y llena los valores del proyecto Firebase
# EXCLUSIVO de esta landing (NO el de CRM/portal de TRES65).
# Firebase Console > Configuración del proyecto > Tus apps > App web > Config.
# Estos valores son públicos por diseño (van en el JavaScript del sitio);
# la seguridad real está en firestore.rules. Aun así, .env.local no se versiona.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Solo si se publica en https://<usuario>.github.io/<repo>/ (ej. /landing-inversion-merida).
# Con dominio propio o en local, dejar vacío.
NEXT_PUBLIC_BASE_PATH=

# Solo desarrollo local con emuladores (npm run dev:emulator ya lo define).
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
