# Copia este archivo a .env.local. Ningún valor aquí es secreto.

# Backend del CRM TRES65 (agente-tres65). La landing NO escribe en Firestore:
# el cuestionario entra por POST /landing/inversion-merida/submit.
NEXT_PUBLIC_CRM_API_URL=https://agente-tres65-production.up.railway.app

# Firebase del CRM (proyecto tres65-perfilcliente), SOLO para el login de /admin
# con las cuentas de agente existentes. Son los mismos valores públicos que ya usa
# WEBSITE/firebase-sync.js (cópialos de ahí).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tres65-perfilcliente.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tres65-perfilcliente
NEXT_PUBLIC_FIREBASE_APP_ID=

# Dashboard de agentes (para el enlace "Abrir ficha del cliente").
NEXT_PUBLIC_CRM_WEB_URL=https://tres65inmobiliaria.github.io/discovery-inmobiliaria

# Solo si se publica en https://<usuario>.github.io/<repo>/ (ej. /landing-inversion-merida).
NEXT_PUBLIC_BASE_PATH=

# Solo desarrollo local (npm run dev:emulator ya lo define).
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
